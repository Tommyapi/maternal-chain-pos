[Unit]
Description=Maternal Chain POS (Flask + gunicorn) - 萌贝收银系统
After=network.target

[Service]
Type=simple
User=shouyin
Group=shouyin
WorkingDirectory=/opt/chainpos/app
Environment=SHOUYIN_DB=/opt/chainpos/data/shouyin.db
Environment=SHOUYIN_COOKIE_PATH=/shouyin
Environment=SHOUYIN_COOKIE_SECURE=1
ExecStart=/opt/chainpos/venv/bin/gunicorn --workers 2 --threads 4 --bind 127.0.0.1:8110 --timeout 60 --access-logfile - --error-logfile - wsgi:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/chainpos/data /opt/chainpos/backup

[Install]
WantedBy=multi-user.target
